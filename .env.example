# Supabase connection — copy this file to .env.local and replace the placeholders.
# Values: Supabase Dashboard -> Settings -> API Keys.
# .env.local is git-ignored. Never commit real values, and never paste them into chats or issues.

# Public: may be sent to the browser (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=your_project_url
# Use the publishable key (sb_publishable_...). The legacy "anon" key also works until Supabase retires it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_key

# SECRET: server only. Never prefix with NEXT_PUBLIC_.
# Use a secret key (sb_secret_...) or the legacy "service_role" key. Bypasses RLS;
# used only by lib/supabase-admin.ts for guest checkout. Leave the placeholder to disable guest checkout.
SUPABASE_SERVICE_ROLE_KEY=your_secret_key
